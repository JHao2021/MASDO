      "target_interval": 32
    },
    "sequence_learning": {
      "hidden": 64,
      "learning_rate": 0.0003,
      "beta_behavior": 0.001,
      "beta_future": 0.001
    },
    "exploration_noise_start": 0.2,
    "exploration_noise_end": 0.02
  },
  "organization": {
    "episodes": 100,
    "learning": {
      "learning_rate": 0.0003,
      "entropy_weight": 0.01,
      "target_interval": 32,
      "warmup_updates": 32,
      "warmup_learning_rate": 0.003
    }
  },
  "discovery_context_steps": 32,
  "discovery_future_steps": 8
}
