{
  "train_scenarios": [
    "data/prepared/train.json"
  ],
  "output_dir": "checkpoints/masdo",
  "device": "cpu",
  "cpu_threads": 1,
  "seed": 0,
  "reachable_distance_km": 3.0,
  "checkpoint_every": 1,
  "objectives": {
    "count": 50,
    "seed": 0,
    "dirichlet_alpha": [
      1.0,
      1.0,
      1.0
    ]
  },
  "environment": {
    "travel_speed_km_per_step": 5.0,
    "distance_reference_km": 3.0,
    "grid_rows": 8,
    "grid_cols": 8
